<Page x:Class="ГалиевЧудоОбувь.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ГалиевЧудоОбувь"
      mc:Ignorable="d"
      d:DesignHeight="450"
      d:DesignWidth="800"
      Title="Каталог Обуви"
      FontFamily="Calibri" >

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="5" HorizontalAlignment="Right">
            <TextBlock Text="Поиск: " FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>

            <TextBox Name="SearchTB" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350"
                     TextChanged="SearchTB_TextChanged"></TextBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center">
            <TextBlock Text="Фильтрация" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
            <ComboBox Name="FiltCB" Width="120" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"
                      SelectionChanged="FiltCB_SelectionChanged">
                <TextBlock>Все</TextBlock>
                <TextBlock>Детская обувь</TextBlock>
                <TextBlock>Женская обувь</TextBlock>
                <TextBlock>Мужская обувь</TextBlock>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="2" Margin="5">
            <TextBlock Text="Сортировка " FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" ></TextBlock>
            <ComboBox Name="SortCB" Width="250" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20" SelectionChanged="SortCB_SelectionChanged">
                <TextBlock>Все</TextBlock>
                <TextBlock>По убыванию цены</TextBlock>
                <TextBlock>По возрастанию цены</TextBlock>
            </ComboBox>
        </StackPanel>

        <ListView Name="ProductListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                            <RowDefinition Height="Auto"></RowDefinition>
                        </Grid.RowDefinitions>
                        <Image  Grid.Row="0" Grid.RowSpan="10" Grid.Column="0" Width="150" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding ProductImage}"></Image>
                        <TextBlock Text="{Binding ProductName}" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"></TextBlock>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="1" >
                            <TextBlock Text="Категория: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding CategoryFull}" FontSize="16" ></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="2">
                            <TextBlock Text="Подкатегория: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding SubcategoryFull}" FontSize="16" ></TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding Description}" Grid.Column="1" Grid.Row="3" FontSize="15"  TextWrapping="Wrap"></TextBlock>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="4">
                            <TextBlock Text="Состав: " FontSize="16" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding Composition}" FontSize="16" TextWrapping="Wrap"></TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="5">
                            <TextBlock Text="Цена: " FontSize="20" FontWeight="SemiBold"></TextBlock>
                            <TextBlock Text="{Binding Price}" FontSize="22" ></TextBlock>
                            <TextBlock Text=" руб." FontSize="20" FontWeight="SemiBold"></TextBlock>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

