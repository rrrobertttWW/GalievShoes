<Window x:Class="ГалиевЧудоОбувь.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ГалиевЧудоОбувь"
        mc:Ignorable="d"
        Title="Чудо обувь" Height="450" Width="800" Icon="res/Чудо Обувь.ico" FontFamily="Calibri" MinWidth="1200" MinHeight="700">
    
    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
       
        <Frame Grid.Row="0" Background="#D2F6E7"></Frame>

        <StackPanel Orientation="Horizontal" Grid.Row="2"
            HorizontalAlignment="Right">
            <Button Name="BtnOrders" Content="Заказы" Width="100" Height="40" Background="#FF70B2AF" Click="BtnOrders_Click" Visibility="Collapsed"/>
            <Button Name="BtnCart" Content="Корзина" Width="100" Height="40" Background="#FF70B2AF" Click="BtnCart_Click" Visibility="Collapsed"/>
        </StackPanel>
        
        <TextBlock Name="UserInfoTB" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
        
        <Image Source="res/Чудо Обувь.png" HorizontalAlignment="Left" Grid.Row="0"></Image>
        <TextBlock Text="Чудо Обувь" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0"></TextBlock>
        <Button Name="BtnBack" Content="Назад" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="100" Height="40" Background="#FF70B2AF" Click="BtnBack_Click"/>
        
        <Frame Grid.Row="1" Name="MainFrame" NavigationUIVisibility="Hidden"></Frame>
    </Grid>
</Window>
