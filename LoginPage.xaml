<Page x:Class="ГалиевЧудоОбувь.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Вход" FontFamily="Calibri">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="400">

            <TextBlock Text="Чудо Обувь" FontSize="32"
                       HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <TextBlock Text="Логин:" FontSize="18" Margin="0,0,0,5"/>
            <TextBox Name="LoginTB" FontSize="18" Padding="5"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,25,0,0">
                <Button Content="Войти" Width="130" Height="40" Margin="5"
                        FontSize="16" Click="LoginBtn_Click"/>
                <Button Content="Гость" Width="130" Height="40" Margin="5"
                        FontSize="16" Click="GuestBtn_Click"/>
            </StackPanel>

            <TextBlock Name="ErrorTB" Foreground="Red" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Page>